# Worktree-local Fredrin tooling — the CLI wrapper carries a scoped API token.
# `.fredrin/memory/` is the exception: it is the project's committed Memory
# bundle (concepts + ADRs), read by every Worker and by Fredrin's Memory tab.
.fredrin/*
!.fredrin/memory/

node_modules/
.next/
out/
build/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env*.local
.vercel
*.tsbuildinfo
next-env.d.ts
